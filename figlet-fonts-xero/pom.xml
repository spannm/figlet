<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.spannm</groupId>
        <artifactId>figlet</artifactId>
        <version>1.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>figlet-fonts-xero</artifactId>
    <packaging>jar</packaging>

    <name>figlet fonts :: xero</name>
    <description>Optional FIGfont and TOIlet font resources for figlet4j: 400 fonts from the xero/figlet-fonts repository, a superset of the figlet.org fonts</description>

    <build>
        <resources>
            <!-- Upstream submodule content, kept 1:1 with xero/figlet-fonts.
                 The excluded *.tlf files are corrupted upstream (ZIP data instead of
                 plain-text TOIlet fonts); corrected copies are supplied by the
                 resources-patched resource below and override them here. -->
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>fonts/**/*.flf</include>
                    <include>fonts/**/*.tlf</include>
                </includes>
                <excludes>
                    <exclude>fonts/ascii12.tlf</exclude>
                    <exclude>fonts/ascii9.tlf</exclude>
                    <exclude>fonts/bigascii12.tlf</exclude>
                    <exclude>fonts/bigascii9.tlf</exclude>
                    <exclude>fonts/bigmono12.tlf</exclude>
                    <exclude>fonts/bigmono9.tlf</exclude>
                    <exclude>fonts/mono12.tlf</exclude>
                    <exclude>fonts/mono9.tlf</exclude>
                    <exclude>fonts/smascii12.tlf</exclude>
                    <exclude>fonts/smascii9.tlf</exclude>
                    <exclude>fonts/smmono12.tlf</exclude>
                    <exclude>fonts/smmono9.tlf</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources-patched</directory>
                <includes>
                    <include>fonts/**/*.tlf</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <!-- bound to initialize, so it runs after the validate-phase execution
                         of the init-font-submodule profile below has fetched the fonts -->
                    <execution>
                        <id>require-font-submodule</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <phase>initialize</phase>
                        <configuration>
                            <rules>
                                <requireFilesExist>
                                    <files>
                                        <file>${project.basedir}/src/main/resources/fonts/Standard.flf</file>
                                    </files>
                                    <message>The xero/figlet-fonts submodule is missing. Run: git submodule update --init --recursive</message>
                                </requireFilesExist>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The release plugin checks out the release tag without git submodules, which left
             all but the patched fonts out of the release. Fetch the submodule whenever it is missing. -->
        <profile>
            <id>init-font-submodule</id>
            <activation>
                <file>
                    <missing>${basedir}/src/main/resources/fonts/Standard.flf</missing>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>init-font-submodule</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <phase>validate</phase>
                                <configuration>
                                    <executable>git</executable>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                    <commandlineArgs>submodule update --init --recursive</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
